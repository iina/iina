// Compile-time availability checks for Swift, similar to those for Objective-C.
// Use these for code that requires newer SDKs that old Xcodes can't recognize.

AVAILABLE_101100 = OS_X_10_11_AVAILABLE MACOS_10_11_AVAILABLE
AVAILABLE_101200 = $(AVAILABLE_101100) MACOS_10_12_AVAILABLE
AVAILABLE_101300 = $(AVAILABLE_101200) MACOS_10_13_AVAILABLE
AVAILABLE_101400 = $(AVAILABLE_101300) MACOS_10_14_AVAILABLE
AVAILABLE_101500 = $(AVAILABLE_101400) MACOS_10_15_AVAILABLE
AVAILABLE_110000 = $(AVAILABLE_101500) MACOS_11_AVAILABLE
AVAILABLE_120000 = $(AVAILABLE_110000) MACOS_12_AVAILABLE
AVAILABLE_130000 = $(AVAILABLE_120000) MACOS_13_AVAILABLE
AVAILABLE_140000 = $(AVAILABLE_130000) MACOS_14_AVAILABLE
AVAILABLE_150000 = $(AVAILABLE_140000) MACOS_15_AVAILABLE
AVAILABLE_160000 = $(AVAILABLE_150000) MACOS_16_AVAILABLE
AVAILABLE_170000 = $(AVAILABLE_160000) MACOS_17_AVAILABLE
AVAILABLE_180000 = $(AVAILABLE_170000) MACOS_18_AVAILABLE
AVAILABLE_190000 = $(AVAILABLE_180000) MACOS_19_AVAILABLE
AVAILABLE_200000 = $(AVAILABLE_190000) MACOS_20_AVAILABLE
AVAILABLE_210000 = $(AVAILABLE_200000) MACOS_21_AVAILABLE
AVAILABLE_220000 = $(AVAILABLE_210000) MACOS_22_AVAILABLE
AVAILABLE_230000 = $(AVAILABLE_220000) MACOS_23_AVAILABLE
AVAILABLE_240000 = $(AVAILABLE_230000) MACOS_24_AVAILABLE
AVAILABLE_250000 = $(AVAILABLE_240000) MACOS_25_AVAILABLE
AVAILABLE_260000 = $(AVAILABLE_250000) MACOS_26_AVAILABLE

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $AVAILABLE_$(SDK_VERSION_MAJOR)
