    "gCv-sJ-uQJ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Always use the dedicated GPU for rendering (if it exists). This can improve performance but may reduce battery life.\"; ObjectID = \"gCv-sJ-uQJ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik altyd die toegewyde grafiese verwerker vir verbeelding (indien dit bestaan). Dit kan verrigting verbeter maar batterylewe verminder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم دائماً وحدة معالجة الرسومات المخصصة لتقديم الخدمات (إن وجدت)، وهذا يمكن أن يحسن الأداء ولكنه قد يقلل من عمر البطارية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza sempre la GPU dedicada per a la renderització (si existeix). Això pot millorar el rendiment, però pot reduir la durada de la bateria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy použít samostatný grafický procesor pro vykreslování (pokud existuje). Toto umožňuje zvýšit výkon, ale může zkrátit výdrž baterie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug altid den dedikerede GPU til gengivelse (hvis den findes). Dette kan forbedre ydeevnen, men kan reducere batteriets levetid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer den dedizierten Grafikprozessor für das Rendering verwenden (falls vorhanden). Dies kann die Leistung verbessern, aber auch die Akkulaufzeit verkürzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always use the dedicated GPU for rendering (if it exists). This can improve performance but may reduce battery life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always use the dedicated GPU for rendering (if it exists). This can improve performance but may reduce battery life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice siempre la GPU dedicada para el renderizado (si existe). Esto puede mejorar el rendimiento pero puede reducir la vida útil de la batería."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همیشه از کارت گرافیکی اختصاصی برای رندر کردن استفاده کن (اگر موجود باشد). این گزینه می تواند کارایی را بالا ببرد ولی عمر باتری را کاهش دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä aina erillistä GPU:ta renderointiin (jos sellainen on olemassa). Tämä voi parantaa suorituskykyä, mutta saattaa lyhentää akun kestoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours utiliser le GPU dédié pour le rendu (s’il existe). Cela peut améliorer les performances, mais peut réduire la durée de vie de la batterie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש תמיד ב-GPU הייעודי (אם קיים) כדי לעבד. זה יכול לשפר את הביצועים, אבל עשוי לצרוך יותר סוללה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvijek koristi određenu grafičku karticu za iscrtavanje (ako postoji). To može poboljšati performansu, ali može skratiti trajanje baterije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindig a dedikált GPU-t használja a rendereléshez (ha van ilyen). Ez javíthatja a teljesítményt, de csökkentheti az akkumulátor élettartamát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selalu gunakan GPU resmi untuk rendering (jika tersedia). Performa dapat meningkat, namun mungkin mengurangi ketahanan baterai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa sempre la GPU dedicata per il rendering (se esiste). Questo può migliorare le prestazioni, ma può ridurre la durata della batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レンダリングに専用GPUを常に使用します(搭載されている場合)。有効化するとパフォーマンスの向上が期待できますが、バッテリー消費が激しくなる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능하면 전용 GPU를 사용하십시오. 성능 뿐만 아니라 배터리 효율도 향상시킬 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video renderēšanai vienmēr izmantot diskrēto videokarti (ja tāda ir). Tā var uzlabot veiktspēju, bet var samazināt akumulatora darbības laiku."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik altijd de toegewijde GPU voor het renderen (als deze bestaat). Dit kan de prestaties verbeteren, maar kan de levensduur van de batterij verminderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze używaj dedykowanej karty graficznej do renderowania (jeżeli istnieje). Może to poprawić wydajność, ale może skrócić czas pracy na baterii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre use a GPU dedicada para a renderização (se existir). Isso pode melhorar o desempenho, mas pode reduzir a duração da bateria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre use a GPU dedicada para a renderização (se existir). Isso pode melhorar o desempenho, mas pode reduzir a duração da bateria."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizaţi întotdeauna GPU special pentru randare (dacă există). Acest lucru poate îmbunătăţi performanţa, dar poate reduce durata de viaţă a bateriei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда используйте выделенный GPU для рендеринга (если он есть). Это может улучшить производительность, но может снизить срок службы батареи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy použiť samostatný grafický procesor na vykresľovanie (ak existuje). Toto umožňuje zvýšiť výkon, ale môže skrátiť výdrž batérie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always use the dedicated GPU for rendering (if it exists). This can improve performance but may reduce battery life."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvek koristi namensku grafičku karticu za prikaz (ako postoji). Ova opcija može poboljšati performanse, ali i umanjiti trajanje baterije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd alltid dedikerad grafikkrets för rendering (om sådan är tillgänglig). Detta kan förbättra prestandan men också minska batteritiden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntü işleme için her zaman ayrı GPU’yu kullanın (varsa). Bu performansınızı artırır; ancak pil düzeyinizi düşürebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для відображення завжди використовувати графічний процесор (за наявності). Це може покращити продуктивність, але зменшить ресурс акумулятора."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn sử dụng GPU (nếu có). Điều này có thể cải thiện hiệu năng hoạt động và làm giảm thời lượng pin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总是使用独立显卡(如果存在)。这可以提高渲染性能，但是可能增加耗电量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渲染時總是使用獨立 GPU (如果可用)。這將會提高效能，但可能會減少電池壽命。"
          }
        }
      }
    },
