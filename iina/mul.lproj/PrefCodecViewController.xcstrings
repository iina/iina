    "aTt-aZ-rjK.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Measured peak brightness of the display. If set to 0, IINA detects this value. If detection fails, IINA sets the target peak to 400.\"; ObjectID = \"aTt-aZ-rjK\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemete hoogste beeldhelderheid. Indien op 0 gestel sal IINA die waarde bespeur. Indien bespeuring misluk, stel IINA die teikenhoogte op 400."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قياس ذروة سطوع العرض. إذا تم تعيينها إلى 0، فإن IINA  يكشف هذه القيمة. إذا فشل الكشف ، فإن IINA يحدد الذروة المستهدفة إلى 400."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změřený maximální jas displeje. Pokud je nastaven na 0, IINA tuto hodnotu detekuje. V případě selhání detekce nastaví IINA cílové maximum na 400."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målt maksimal lysstyrke for skærmen. Hvis sat til 0, finder IINA denne værdi. Hvis dette mislykkes, sætter IINA målet for maksimal værdi til 400."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessener Helligkeits-Spitzenwert des Bildschirms. Wenn auf 0 gesetzt, erkennt IINA diesen Wert. Wenn diese Erkennung fehlschlägt, setzt IINA den Wert auf 400."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Measured peak brightness of the display. If set to 0, IINA detects this value. If detection fails, IINA sets the target peak to 400."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured peak brightness of the display. If set to 0, IINA detects this value. If detection fails, IINA sets the target peak to 400."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medida del máximo brillo de la pantalla. Si se establece en 0, IINA detecta este valor. Si la detección falla, IINA establece el pico objetivo a 400."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosité maximale mesurée de l'écran, Si défini à 0, IINA détecte la valeur automatiquement. Si la détection auto échoue, la valeur est fixée à 400."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהירות מרבית מדודה של התצוגה. אם מוגדר ל-0, IINA יזהה אוטומטית ערך זה. אם הזיהוי נכשל, IINA יגדיר את שיא היעד ל-400."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izmjerena najveća svjetloća ekrana. Ako je postavljeno na 0, IINA otkriva ovu vrijednost. Ako otkrivanje ne uspije, IINA postavlja ciljanu najveću svjetloću na 400."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelző fényerejének mért csúcsa. Amennyiben 0, az IINA felismeri ezt az értéket. Amennyiben a felismerés sikertelen, az IINA a célértéket 400-ra állítja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengukuran puncak kecerahan layar. Jika diatur ke 0, IINA mendeteksi nilai ini. Jika deteksi gagal, IINA menetapkan puncak target ke 400."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosità massima del display misurata correttamente. Se impostata su 0, IINA rileva automaticamente questo valore. Se la rilevazione fallisce, il picco è impostato su 400."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定したディスプレイのピーク明るさを設定してください。設定値が0の場合、IINAがこの値を自動で検出します。検出に失敗した場合、IINAはピーク明るさを400に設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이의 측정된 최대 밝기입니다. 0으로 설정하면 IINA가 이 값을 감지합니다. 감지에 실패하면 IINA는 최대 밝기를 400으로 설정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeten helderheid van het scherm. Indien ingesteld op 0, detecteert IINA deze waarde. Als detectie mislukt, stelt IINA de doel piek in op 400."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczytowa jasność wyświetlacza. Jeśli ustawione na 0, IINA podejmie próbę wykrycia. Jeśli próba się nie powiedzie, IINA ustawi tę wartość na 400."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilho pico do ecrã. Se deixado a 0 o IINA detetará este valor. Se o IINA não conseguir detetar, o brilho pico será predefinido para 400."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico de brilho medido da tela. Se definido como 0, o IINA detetará esse valor. Se a deteção falhar, o IINA definirá o pico alvo como 400."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoarea luminozității maxime a afișajului. Dacă e setat pe 0, IINA detectează această valoare. Dacă detecția eșuează, IINA setează luminozitatea maximă la 400."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измеренная пиковая яркость дисплея. Если установлено 0, IINA автоматически определяет это значение. Если автоопределение не удалось, IINA устанавливает пиковую яркость в 400."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmeraný maximálny jas displeja. Pokiaľ je nastavený na 0, IINA túto hodnotu detekuje. V prípade zlyhania detekcie nastaví IINA cieľové maximum na 400."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured peak brightness of the display. If set to 0, IINA detects this value. If detection fails, IINA sets the target peak to 400."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranın ölçülen tepe parlaklığı. 0 olarak ayarlanırsa IINA bu değeri algılar. Algılama başarısız olursa IINA hedef zirveyi 400 olarak ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимірювана пікова яскравість дисплея. Якщо встановлено 0, IINA автоматично визначає це значення. Якщо автовизначення не вдалося, IINA встановлює пікову яскравість 400."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测量的显示器的峰值亮度。如果设置为0，IINA会检测这个值。如果检测失败，IINA会将目标峰值设为400。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕的測量最大亮度。如果設為0，IINA將檢測此值。若檢測失敗，IINA將目標峰值設為400。"
          }
        }
      }
    },
