    "M2M-of-gjd.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Load the ICC profile for current display and use it to transform video RGB to screen output. (Only for SDR mode)\"; ObjectID = \"M2M-of-gjd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laai die ICC-profiel vir ide huidige skerm en gebruik dit om video-RGB na skermafvoer om te skakel. (Slegs vir SDR-modus)"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحميل الملف الشخصي لغرفة التجارة الدولية للعرض الحالي واستخدامه لتحويل RGB الفيديو لشاشة الإخراج. (فقط لوضع حقوق السحب الخاصة)"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrega el perfil ICC per a la visualització actual i utilitza'l per transformar vídeo RGB a la sortida de pantalla. (només per al mode SDR)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načíst ICC profil pro aktuální displej a použít jej k transformaci RGB videa na výstup obrazovky. (Pouze pro režim SDR)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indlæs ICC-profilen for nuværende skærm og brug den til at transformere video-RGB til skærm-output. (Kun for SDR-tilstand)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ICC-Profil für den aktuellen Bildschirm laden und zur Umwandlung von Video-RGB in die Bildschirmausgabe verwenden. (Nur für den SDR-Modus)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Load the ICC profile for current display and use it to transform video RGB to screen output. (Only for SDR mode)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load the ICC profile for current display and use it to transform video RGB to screen output. (Only for SDR mode)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargar el perfil ICC para la visualización actual y utilizarlo para transformar el vídeo RGB para la salida de pantalla. (Solo para el modo SDR)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charger le profil ICC pour l'affichage actuel et l'utiliser pour transformer le RVB vidéo en sortie d'écran. (Uniquement pour le mode SDR)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טען את פרופיל ה-ICC עבור התצוגה הנוכחית והשתמש בו כדי להפוך וידאו RGB לפלט מסך. (עבור מצב SDR בלבד)"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učitaj ICC profil za trenutačni prikaz i koristi ga za transformaciju RGB videa rezultata. (Samo za SDR modus)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betölti az aktuális kijelző ICC-profilját, és használja azt a videó RGB átalakításához a képernyő kimenetére. (Csak SDR módban)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memuat profil ICC untuk tampilan saat ini dan gunakan untuk mengubah video RGB ke output layar. (Hanya untuk mode SDR)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carica il profilo ICC per il display corrente e usalo per trasformare il video RGB in uscita a schermo. (Solo per la modalità SDR)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のディスプレイのICCプロファイルをロードし、ビデオRGBをスクリーン出力に変換するために使用します。(SDRモードの場合のみ)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 디스플레이에 ICC 프로파일을 적용하여 비디오의 RGB를 변환하여 스크린에 출력합니다. (SDR 모드에서만 작동합니다)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laad het ICC-profiel voor huidige weergave en gebruik het om video RGB om te zetten naar schermuitvoer. (Alleen voor SDR-modus)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Załaduj profil ICC dla bieżącego wyświetlacza i użyj go do przekształcania wideo RGB na wyjście ekranu. (Tylko dla trybu SDR)"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregar o perfil ICC do ecrã atual e aplica-lo ao vídeo de saída. (Apenas valido em SDR)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregar o perfil ICC para tela atual e usá-lo para transformar vídeo RGB em saída de tela. (Apenas para o modo SDR)"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încarcă profilul ICC pentru display-ul curent și folosește-l pentru a transforma video RGB în output pe ecran. (Numai pentru modul SDR)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузить ICC-профиль текущего дисплея и использовать его для преобразования RGB-видео (только для SDR-видео)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načítať ICC profil pre aktuálny displej a použiť ho na transformáciu RGB videa na výstup obrazovky. (Len pre režim SDR)"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load the ICC profile for current display and use it to transform video RGB to screen output. (Only for SDR mode)"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učitaj ICC profil za trenutni ekran i pomoću njega transformiši video RGB u prikaz ekrana (samo za SDR režim)"
          }
        },
        "sv" : {
