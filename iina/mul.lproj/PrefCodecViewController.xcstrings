    "HQV-tY-NMj.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"If this option is not enabled, clipping will be prevented by lowering the gain.\"; ObjectID = \"HQV-tY-NMj\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم يتم تمكين هذا الخيار، سيتم منع النقر عن طريق تقليل المكسب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud není tato možnost povolena, zabrání se odstřižení snížením zesílení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis denne indstilling ikke er slået til, så bliver klip i lyden forhindret ved at mindske lydstyrkeforøgelsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If this option is not enabled, clipping will be prevented by lowering the gain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this option is not enabled, clipping will be prevented by lowering the gain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si esta opción no está activada, el recorte se evitará reduciendo la ganancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option n'est pas activée, la saturation sera empêché en abaissant le gain."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako je ova opcija isključena, odrezivanje će biti spriječeno smanjivanjem pojačanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ez az opció nincs engedélyezve, akkor az erősítés csökkentésével meg lesz akadályozva a \"clipping\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se questa opzione non è abilitata, lo sforamento sarà impedito con la riduzione del guadagno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このオプションがオフのとき、ゲインを下げてクリッピングを防止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션이 비활성화되어 있는 경우, 음량을 낮춰 클리핑을 방지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als deze optie niet is ingeschakeld, wordt clippen voorkomen door de versterking te verlagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli wyłączone, obniżone wzmocnienie będzie zapobiegać przesterom."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esta opção não estiver ativada, será evitada a saturação diminuindo o ganho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă această opțiune nu este activă, clipping-ul va fi prevenit prin micșorarea amplificării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если эта опция выключена, клиппинг будет предотвращен путем снижения коэффициента усиления."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this option is not enabled, clipping will be prevented by lowering the gain."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçenek etkinleştirilmemişse kırpma, kazanç azaltılarak engellenecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо цей параметр не ввімкнуто, буде запобігати відсіканню шляхом зниження посилення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果未启用此选项，将会通过降低增益来防止削波。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果未啟用此選項，將會通過降低增益來防止削波。"
          }
        }
      }
    },
