    "fnl-uA-X7r.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"You can install a new plugin from GitHub or a local .iinaplgz package. Plugins installed from GitHub can be updated automatically.\"; ObjectID = \"fnl-uA-X7r\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kan ’n nuwe inprop installeer vanaf GitHub of ’n lokale .iinaplgz-pakket. Inproppe wat vanaf GitHub geïnstalleer is kan outomaties bygewerk word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تثبيت إضافة جديدة من GitHub أو حزمة .iinaplgz محلية. يمكن تحديث الإضافات المثبتة من GitHub تلقائياً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový plug-in můžete nainstalovat z GitHub nebo místního .iinaplgz balíčku. Plug-iny nainstalované z GitHub lze aktualizovat automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan installere en ny tilføjelse fra GitHub eller en lokal .iinaplgz-pakke. Tilføjelser installeret fra GitHub kan opdateres automatisk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can install a new plugin from GitHub or a local .iinaplgz package. Plugins installed from GitHub can be updated automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede instalar un nuevo plugin desde GitHub o un paquete .iinaplgz local. Los plugins instalados desde GitHub se pueden actualizar automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez installer un nouveau module externe depuis GitHub ou un paquet .iinaplgz local. Les modules externes installés depuis GitHub peuvent être mis à jour automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה יכול להתקין תוסף חדש מ-GitHub או חבילת .iinaplgz מקומית. תוספים המותקנים מ-GitHub ניתנים לעדכון אוטומטי."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telepíthet egy új plugint a GitHubról vagy egy helyi .iinaplgz csomagból. A GitHubról telepített bővítmények automatikusan frissülnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi installare un plug-in da GitHub o da un pacchetto locale .iinaplgz. I plug-in installati da GitHub possono essere aggiornati automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいプラグインをGitHubまたはローカルの.iinaplgzパッケージからインストールできます。GitHubからインストールしたプラグインは自動的にアップデートされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 또는 로컬 .iinaplgz 패키지에서 새 플러그인을 설치할 수 있습니다. GitHub에서 설치한 플러그인은 자동으로 업데이트할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een nieuwe plugin installeren vanaf GitHub of een lokaal .iinaplgz pakket. Plugins geïnstalleerd vanaf GitHub kunnen automatisch worden bijgewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zainstalować nową wtyczkę z GitHub lub lokalnego pakietu .iinaplgz. Wtyczki zainstalowane z GitHub mogą być aktualizowane automatycznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode instalar um novo plugin com o GitHub ou com um ficheiro .iinaplgz . Os plugins instalados do GitHub podem ser atualizados automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puteți instala un nou plugin din GitHub sau un pachet local .iinaplgz. Plugin-urile instalate din GitHub pot fi actualizate automat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете установить новый плагин с GitHub или локальный пакет .iinaplgz. Плагины, установленные с GitHub, могут обновляться автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan installera ett nytt tillägg från GitHub eller ett lokalt .iinaplgz-paket. Tillägg installerade från GitHub kan uppdateras automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir eklentiyi GitHub’dan veya yerel bir .iinaplgz paketinden yükleyebilirsiniz. GitHub’dan yüklenen eklentiler otomatik olarak güncellenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви можете встановити новий плагін з GitHub або локальний .iinaplgz пакет. Плагіни встановлені з GitHub, можна оновлювати автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以从GitHub或本地的 .iinaplgz包安装新插件。从GitHub安装的插件可以自动更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以從 GitHub 或利用 .iinaplgz 包安裝新外掛程式。從 GitHub 安裝的外掛程式支援自動更新。"
          }
        }
      }
    },
