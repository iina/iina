    "Nmf-79-hFX.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Please enter the full URL of the GitHub repository or a string in the \\\"user/repo\\\" format. You can also choose one from the default plugins list.\"; ObjectID = \"Nmf-79-hFX\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul die volledige bronadres van die GitHub-opslagplek of ’n string in die “user/repo”-formaat. U kan ook een kies uit die verstekinproppe."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرجاء إدخال عنوان URL الكامل لمستودع GitHub أو سلسلة في تنسيق \"المستخدم/repo\". يمكنك أيضا اختيار واحدة من قائمة الإضافات الافتراضية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte prosím úplnou URL adresu úložiště GitHub nebo řetězec ve formátu „uživatel/repozitář“. Můžete také vybrat jeden z výchozích plugi-nů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast den fulde URL til GitHub-repositoriet eller en streng i formatet \"bruger/repo\". Du kan også vælge en fra standardlisten over tilføjelser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please enter the full URL of the GitHub repository or a string in the \"user/repo\" format. You can also choose one from the default plugins list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, introduzca la URL completa del repositorio de GitHub o una cadena en el formato \"user/repo\". También puede elegir uno de la lista de plugins por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez entrer l'URL complète du dépôt GitHub ou une chaîne de caractères au format « user/repo ». Vous pouvez également en choisir un dans la liste des modules externes par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנא הזן את כתובת האתר המלאה של מאגר GitHub או מחרוזת בפורמט \"משתמש/ריפו\". אתה יכול גם לבחור אחד מרשימת התוספים המוגדרים כברירת מחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérjük, adja meg a GitHub tároló teljes URL címét vagy egy „user/repo” formátumú karakterláncot. Az alapértelmezett bővítmények listájából is választhat egyet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci l'URL completo del repository GitHub o una stringa nel formato 'user/repo'. Puoi anche sceglierne uno dall'elenco dei plug-in predefiniti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubリポジトリのURLまたは\"user/repo\"形式の文字列を入力してください。デフォルトのプラグイン一覧から選択することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 리포지토리의 전체 URL 또는 “사용자/리포지토리” 형식의 문자열을 입력하세요. 기본 플러그인 목록에서 하나를 선택할 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul de volledige URL van de GitHub repository of een string in het \"user/repo\" formaat. Je kunt er ook één kiezen uit de standaard plug-ins."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza o URL do repositório GitHub ou a string correspondente a \"user/repo\". Também pode escolher da lista dos plugins incluídos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, insira a URL completa do repositório GitHub ou o texto no formato \"usuário/repo\". Você também pode escolher um dos plug-ins padrão listado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți URL-ul complet al repository-ului GitHub sau un identificator de forma \"user/repo\". De asemenea, puteți alege unul din lista de plugin-uri implicită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, введите полный URL GitHub-репозитория или строку в формате «пользователь/репозиторий». Вы также можете выбрать его из списка плагинов по умолчанию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange hela URL:en till GitHub-arkivet eller en sträng i formatet \"user/repo\". Du kan också välja ett från listan av standardtillägg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen GitHub deposunun tam yolunu veya bir diziyi ”kullanıcı/depo“ biçiminde girin. Ayrıca saptanmış eklentiler listesinden de bir tane seçebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, введіть повний URL репозиторію GitHub або рядок у форматі \"user/repo\". Ви також можете вибрати один зі списку типових плагінів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入GitHub仓库的完整URL或“user/repo”格式的字符串。你也可以从默认插件列表中选择一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入 GitHub 儲存庫的完整 URL 或「user/repo」格式的字串。\n您也可以從預設外掛程式清單中選擇一個。"
          }
        }
      }
    },
