+static void cmd_lavfi_complex_command(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct mp_filter_command filter_cmd = {
+        .type = MP_FILTER_COMMAND_TEXT,
+        .target = cmd->args[0].v.s,
+        .cmd = cmd->args[1].v.s,
+        .arg = cmd->args[2].v.s,
+        .persistent = true,
+    };
+    cmd->success = mpctx->lavfi && mp_filter_command(mpctx->lavfi, &filter_cmd);
+    bool keep_audio = mpctx->audio_status == STATUS_PLAYING &&
+                      !get_internal_paused(mpctx);
+    double pts = keep_audio ? written_audio_pts(mpctx) : playing_audio_pts(mpctx);
+    if (cmd->success && cmd->args[3].v.b && mpctx->ao_chain &&
+        mp_lavfi_replay_audio(mpctx->lavfi, pts))
+    {
+        struct ao_chain *ao_c = mpctx->ao_chain;
+        mp_filter_reset(ao_c->filter->f);
+        if (keep_audio) {
+            ao_c->refresh_pts = pts;
+        } else {
+            clear_audio_output_buffers(mpctx);
+            mp_filter_reset(ao_c->ao_filter);
+            reset_audio_state(mpctx);
+        }
+        mp_wakeup_core(mpctx);
+    }
 }
 
