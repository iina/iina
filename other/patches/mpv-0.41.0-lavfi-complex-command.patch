+bool mp_lavfi_replay_audio(struct mp_filter *f, double pts)
+{
+    struct lavfi *c = f->priv;
+    if (c->force_type || !c->initialized || pts == MP_NOPTS_VALUE)
+        return false;
+    bool audio = false;
+    for (int n = 0; n < c->num_in_pads; n++) {
+        struct lavfi_pad *pad = c->in_pads[n];
+        if (pad->type != MP_FRAME_AUDIO)
+            continue;
+        audio = true;
+        if (!pad->num_history ||
+            mp_aframe_get_pts(pad->history[0].data) > pts + 0.001 ||
+            (!pad->input_eof &&
+             mp_aframe_end_pts(pad->history[pad->num_history - 1].data) < pts))
+            return false;
+    }
+    if (!audio)
+        return false;
+    for (int n = 0; n < c->num_in_pads; n++) {
+        struct lavfi_pad *pad = c->in_pads[n];
+        if (pad->pending_replay) {
+            mp_frame_unref(&pad->pending);
+        } else if (pad->pending.type) {
+            mp_assert(!pad->live_pending.type);
+            pad->live_pending = pad->pending;
+            pad->pending = MP_NO_FRAME;
+        }
+        pad->pending_replay = false;
+        pad->replaying = true;
+        pad->replay_pos = 0;
+        if (pad->type == MP_FRAME_AUDIO) {
+            while (pad->replay_pos + 1 < pad->num_history &&
+                   mp_aframe_end_pts(pad->history[pad->replay_pos].data) <= pts)
+                pad->replay_pos++;
+            // Warm up converters/limiters before trimming processed output.
+            if (pad->replay_pos > 0)
+                pad->replay_pos--;
+            if (pad->input_eof &&
+                mp_aframe_end_pts(pad->history[pad->num_history - 1].data) <= pts)
+                pad->replay_pos = pad->num_history;
+        }
+    }
+    for (int n = 0; n < c->num_out_pads; n++)
+        c->out_pads[n]->replay_video_pts = c->out_pads[n]->last_video_pts;
+    free_graph(c);
+    mp_filter_wakeup(f);
+    return true;
+}
