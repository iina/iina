+static void clear_history(struct lavfi_pad *pad)
+{
+    for (int n = 0; n < pad->num_history; n++)
+        mp_frame_unref(&pad->history[n]);
+    pad->num_history = 0;
+    pad->history_bytes = 0;
+    pad->replaying = pad->pending_replay = pad->input_eof = false;
+    mp_frame_unref(&pad->live_pending);
+    mp_frame_unref(&pad->last_video);
+    pad->last_video_pts = MP_NOPTS_VALUE;
+    pad->replay_video_pts = MP_NOPTS_VALUE;
+}
+
+static void remember_input(struct lavfi *c, struct lavfi_pad *pad)
+{
+    if (c->force_type || pad->pending_replay)
+        return;
+    struct mp_frame frame = pad->pending;
+    pad->input_eof = frame.type == MP_FRAME_EOF;
+    if (frame.type == MP_FRAME_VIDEO) {
+        mp_frame_unref(&pad->last_video);
+        pad->last_video = mp_frame_ref(frame);
+    } else if (frame.type == MP_FRAME_AUDIO) {
+        struct mp_aframe *af = frame.data;
+        double pts = mp_aframe_get_pts(af);
+        double end = mp_aframe_end_pts(af);
+        if (pts == MP_NOPTS_VALUE)
+            return;
+        if (pad->num_history) {
+            struct mp_aframe *last = pad->history[pad->num_history - 1].data;
+            if (!mp_aframe_config_equals(af, last) ||
+                pts < mp_aframe_get_pts(last))
+                clear_history(pad);
+        }
+        struct mp_frame ref = mp_frame_ref(frame);
+        MP_HANDLE_OOM(ref.data);
+        MP_TARRAY_APPEND(pad, pad->history, pad->num_history, ref);
+        pad->history_bytes += mp_aframe_approx_byte_size(af);
+        size_t limit = MPMIN(16 * 1024 * 1024,
+                            64 * 1024 * 1024 / c->num_in_pads);
+        while (pad->num_history > 1 &&
+               (mp_aframe_end_pts(pad->history[0].data) < end - 12.0 ||
+                pad->history_bytes > limit || pad->num_history > 4096))
+        {
+            pad->history_bytes -= mp_aframe_approx_byte_size(pad->history[0].data);
+            mp_frame_unref(&pad->history[0]);
+            MP_TARRAY_REMOVE_AT(pad->history, pad->num_history, 0);
+        }
+    }
+}
 
